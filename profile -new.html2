<!DOCTYPE html>
<html><head><meta name="viewport" content="width=device-width, initial-scale=1">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:sans-serif}
body{background:#000;color:#fff}
.top{display:flex;justify-content:space-between;padding:12px}
.prof{display:flex;gap:16px;padding:10px;align-items:center}
.prof img{width:82px;height:82px;border-radius:50%;object-fit:cover}
.stats{display:flex;flex:1;justify-content:space-around;text-align:center}
.stats b{display:block}
.btns{display:flex;gap:8px;padding:10px}
.btns button{flex:1;background:#262626;color:#fff;border:none;padding:9px;border-radius:8px;font-weight:700}
.people{display:flex;gap:10px;overflow-x:auto;padding:0 12px}
.person{min-width:150px;background:#111;border-radius:12px;padding:14px;text-align:center}
.person img{width:70px;height:70px;border-radius:50%}
.person button{width:100%;background:#0095f6;color:#fff;border:none;padding:8px;border-radius:8px;margin-top:8px}
.tabs{display:flex;border-top:1px solid #222;margin-top:12px}
.tabs button{flex:1;background:none;border:none;color:#888;padding:12px;font-size:22px}
.tabs button.active{color:#fff}
.grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:2px}
.grid img{width:100%;aspect-ratio:1/1;object-fit:cover}
.settings{display:none;padding:14px}
.set-item{display:flex;justify-content:space-between;padding:13px 0;border-bottom:1px solid #222}
</style></head>
<body>

<div id="p1">
<div class="top"><span>+</span><b>🔒 shiv_amgupta47243 ⌄</b><span onclick="showS()">☰</span></div>
<div class="prof">
<img src="https://via.placeholder.com/150">
<div class="stats">
<div><b>7</b><span>posts</span></div>
<div><b>66</b><span>followers</span></div>
<div><b>102</b><span>following</span></div>
</div>
</div>
<div style="margin:0 14px;background:#1a1a1a;display:inline-block;padding:6px 12px;border-radius:20px;font-size:13px">@ shiv_amgupta47243</div>
<div class="btns"><button>Edit profile</button><button>Share profile</button></div>
<div style="display:flex;justify-content:space-between;padding:12px"><b>Discover people</b><a href="#" style="color:#0095f6;text-decoration:none">See All</a></div>
<div class="people">
<div class="person"><img src="https://via.placeholder.com/100"><br><b>liv 🌹</b><br><span style="font-size:12px;color:#888">Suggested for you</span><button>Follow</button></div>
<div class="person"><img src="https://via.placeholder.com/100"><br><b>💞💞</b><br><span style="font-size:12px;color:#888">Suggested for you</span><button>Follow</button></div>
<div class="person"><img src="https://via.placeholder.com/100"><br><b>Family</b><br><span style="font-size:12px;color:#888">Suggested</span><button>Follow</button></div>
</div>
<div class="tabs"><button class="active">⊞</button><button>▶️</button><button>⇄</button><button>👤</button></div>
<div class="grid">
<img src="https://via.placeholder.com/300"><img src="https://via.placeholder.com/300"><img src="https://via.placeholder.com/300">
<img src="https://via.placeholder.com/300"><img src="https://via.placeholder.com/300"><img src="https://via.placeholder.com/300">
</div>
</div>

<div id="s1" class="settings">
<h2>← Settings and activity</h2>
<div style="background:#262626;padding:11px;border-radius:10px;margin-top:12px">🔍 Search</div>
<p style="color:#888;margin:18px 0 6px">Your account</p>
<div class="set-item"><b>Accounts Centre</b><span>›</span></div>
<p style="font-size:12px;color:#888">Password, security, personal details</p>
<p style="color:#888;margin:18px 0 6px">How you use Instagram</p>
<div class="set-item"><span>🔖 Saved</span><span>›</span></div>
<div class="set-item"><span>🕘 Archive</span><span>›</span></div>
<div class="set-item"><span>📊 Your activity</span><span>›</span></div>
<div class="set-item"><span>🔔 Notifications</span><span>›</span></div>
<div class="set-item"><span>⏰ Time management</span><span>›</span></div>
<div class="set-item"><span>⭐ Instagram early access</span><span>›</span></div>
<p style="color:#888;margin:18px 0 6px">Subscriptions</p>
<div class="set-item"><span>💎 Instagram Plus</span><span>Not subscribed ›</span></div>
<div class="set-item"><span>① Meta One</span><span>Not subscribed ›</span></div>
<br><button onclick="backP()" style="width:100%;background:#262626;color:#fff;border:none;padding:12px;border-radius:10px">← Back to Profile</button>
</div>

<script>
function showS(){document.getElementById('p1').style.display='none';document.getElementById('s1').style.display='block';window.scrollTo(0,0)}
function backP(){document.getElementById('s1').style.display='none';document.getElementById('p1').style.display='block'}
</script>
</body></html>
